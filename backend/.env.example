# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-very-long-random-secret-key
# Required to accept roadside requests. Keep stable and back it up securely.
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ROADSIDE_DATA_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/find_your_mechanic
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/find_your_mechanic

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@findyourmechanic.com
SMTP_PASSWORD=change-me
EMAIL_FROM=no-reply@findyourmechanic.com
EMAIL_FROM_NAME=Find Your Mechanic

# ─── Cloud Storage (stubbed — swap provider as needed) ────────────────────────
STORAGE_PROVIDER=stub
# STORAGE_PROVIDER=local   # saves uploads to UPLOAD_DIR and serves them at /api/v1/media
# UPLOAD_DIR=uploads
# AWS S3 (activate when ready):
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-1
# S3_BUCKET=find-your-mechanic-photos

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_ANALYTICS=30/minute
RATE_LIMIT_ROADSIDE=5/hour

# Optional: set a predictable password for all local seeded accounts.
# Leave blank to generate a random password printed by the seed command.
SEED_PASSWORD=MechaRoadside2026!

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

